EJUDGE_BASE_URL=https://ejudge.lksh.ru
EJUDGE_TIMEOUT=15s

# STORE_DIR — каталог персистентности посылок/курсоров (store.FS)
STORE_DIR=./data

MONGO_INITDB_ROOT_USERNAME=scainer
MONGO_INITDB_ROOT_PASSWORD=
MONGODB_HOST=localhost
MONGODB_DATABASE=scainer

# JOBS_MAX_CONCURRENT — сколько контестов дозагружается+анализируется одновременно (пул воркеров).
# ANALYZE_CONCURRENCY — общий (на все job'ы разом, не на один) потолок одновременных
JOBS_MAX_CONCURRENT=4
ANALYZE_CONCURRENCY=4

JWT_SECRET=
# Смена / рабочий день; длиннее — дольше живёт украденный токен.
JWT_TTL=12h

# Учётки преподавателей через запятую.
# TEACHERS_PASSWORDS=alice:secret,bob:pass2

# OpenAI-совместимый API (Ollama /v1). Native Ollama — /api. Basic Auth.
OPENAI_BASE_URL=https://ollamaapi.n.icpc.live/v1
OPENAI_USERNAME=
OPENAI_PASSWORD=
OPENAI_TIMEOUT=60s
# OPENAI_MODEL=llama3.2

# AIUSAGE_ENABLED=1
